# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Values below are for running the app on your machine against `docker compose`
# postgres/redis. Inside docker compose, DATABASE_URL/REDIS_URL are overridden.

# local | test | staging | production
APP_ENV=local

# ---------------------------------------------------------------- logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (readable) | json (one JSON object per line; use in staging/production)
LOG_FORMAT=console
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=90
LOG_SQL=false

# ---------------------------------------------------------------- database / redis
DATABASE_URL=postgresql+asyncpg://kaladhaga:kaladhaga@localhost:5433/kaladhaga
TEST_DATABASE_URL=postgresql+asyncpg://kaladhaga:kaladhaga@localhost:5433/kaladhaga_test
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- providers
# fake = log to console, contact nobody. Real ones arrive in later stages.
# TELEPHONY_PROVIDER: fake | exotel    SMS_PROVIDER: fake | exotel    PUSH_PROVIDER: fake | fcm
TELEPHONY_PROVIDER=fake
SMS_PROVIDER=fake
PUSH_PROVIDER=fake

# Trust X-Forwarded-For for the client IP. true only behind our own load balancer.
TRUST_FORWARDED_FOR=false

# ---------------------------------------------------------------- secrets
# Required (32+ chars) in staging/production. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-prod
TOKEN_HASH_SECRET=dev-only-insecure-secret-change-me-in-prod

# ---------------------------------------------------------------- auth
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_S=600
OTP_LENGTH=4
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_S=30
OTP_MAX_SENDS_PER_HOUR=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_S=900
# Local only: every OTP is this code (docker compose sets 1234). Refused in staging/production.
# OTP_FIXED_CODE=1234
# Exotel DLT template id of the OTP SMS (needed for real sends).
# SMS_OTP_TEMPLATE_ID=
