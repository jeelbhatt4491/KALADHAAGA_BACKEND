# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Values below are for running the app on your machine against `docker compose`
# postgres/redis. Inside docker compose, DATABASE_URL/REDIS_URL are overridden.

# local | test | staging | production
APP_ENV=local

# ---------------------------------------------------------------- logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (readable) | json (one JSON object per line; use in staging/production)
LOG_FORMAT=console
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=90
LOG_SQL=false

# ---------------------------------------------------------------- database / redis
DATABASE_URL=postgresql+asyncpg://kaladhaga:kaladhaga@localhost:5433/kaladhaga
TEST_DATABASE_URL=postgresql+asyncpg://kaladhaga:kaladhaga@localhost:5433/kaladhaga_test
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- providers
# fake = log to console, contact nobody. Real ones arrive in later stages.
# TELEPHONY_PROVIDER: fake | exotel    SMS_PROVIDER: fake | exotel    PUSH_PROVIDER: fake | fcm
TELEPHONY_PROVIDER=fake
SMS_PROVIDER=fake
PUSH_PROVIDER=fake

# ---------------------------------------------------------------- secrets
# Required in staging/production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me
